# Shared mode. Leave both blank to keep everything in this browser only.
#
# Supabase → Project Settings → API. The anon key is safe to expose in a browser
# app only in the sense that it is *meant* to be public: with the open-access policy
# in supabase/schema.sql, anyone with these values can read and write the tracker.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
